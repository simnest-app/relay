# Copy to .env and fill in. Only EXTERNAL_IP is required.

# This machine's public IP address: the cloud host's public address, or your home router's.
EXTERNAL_IP=

# What phones connect to, if not the address above: a domain name that points at it.
#RELAY_HOST=relay.example.com

# This machine's address in its own network, for a gateway at the same place (found by itself when left empty).
#LAN_IP=192.168.1.10

# Ports. Open LISTEN_PORT (UDP and TCP) and MIN_PORT to MAX_PORT (UDP) in the firewall, and forward them on the
# router if the machine is at home. A call in progress uses a few ports of the range, and more for some minutes after
# its phone changes network. Keep more ports in the range than TOTAL_QUOTA.
#LISTEN_PORT=3478
#MIN_PORT=49160
#MAX_PORT=49359

# Limits: relay sessions in all, per device, and kbps per session. A phone that changes network during a call holds
# the sessions of the network it left for up to ten minutes, so the share per device is well above one call's.
#TOTAL_QUOTA=160
#USER_QUOTA=24
#MAX_KBPS=256

# The setup page's port, reachable from this machine's own network only.
#PAGE_PORT=8787
