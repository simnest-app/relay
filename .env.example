# Copy to .env and fill in. Only EXTERNAL_IP is required.

# This machine's public IP address: the cloud host's public address, or your home router's.
EXTERNAL_IP=

# What phones connect to, if not the address above: a domain name that points at it.
#RELAY_HOST=relay.example.com

# This machine's address in its own network, for a gateway at the same place (found by itself when left empty).
#LAN_IP=192.168.1.10

# Ports. Open LISTEN_PORT (UDP and TCP) and MIN_PORT to MAX_PORT (UDP) in the firewall, and forward them on the
# router if the machine is at home. Each call in progress uses one or two ports of the range.
#LISTEN_PORT=3478
#MIN_PORT=49160
#MAX_PORT=49200

# Limits: relay sessions in all, per credential, and kbps per session.
#TOTAL_QUOTA=20
#USER_QUOTA=6
#MAX_KBPS=256

# The setup page's port, reachable from this machine's own network only.
#PAGE_PORT=8787
